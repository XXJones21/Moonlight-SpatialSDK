@@ -0,0 +1,28 @@
+#pragma once
+#include <portal/Protocol.hpp>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+namespace uevrportal {
+// Receiver owns only protocol state. Renderer publishes immutable status; it never calls recv/send.
+class PortalSession {
+public:
+    static PortalSession& get();
+    PortalSession();
+    ~PortalSession();
+    std::optional<portal::StateSnapshot> latest() const;
+    bool matchesLease(const portal::StateSnapshot&) const;
+    void status(portal::StatusSnapshot status);
+    std::string error() const;
+private:
+    void receive(std::stop_token stop);
+    mutable std::mutex mutex_;
+    portal::StateAcceptance acceptance_;
+    portal::StatusSnapshot status_{};
+    portal::StateAcceptance::Clock::time_point statusTime_{};
+    std::string error_="awaiting_state";
+    std::jthread worker_;
+};
+}
