diff --git a/src/mods/portal/PortalFrame.cpp b/src/mods/portal/PortalFrame.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..94380eddcd7401501b0783f184be03818a9d8525
--- /dev/null
+++ b/src/mods/portal/PortalFrame.cpp
@@ -0,0 +1,67 @@
+#include "PortalFrame.hpp"
+#include "PortalSession.hpp"
+#include "../WindowMode.hpp"
+#include "../VR.hpp"
+#include <spdlog/spdlog.h>
+#include <atomic>
+
+namespace uevrportal {
+namespace {
+std::mutex cacheMutex;
+std::atomic<std::uint64_t> currentID{};
+struct Slot {std::shared_ptr<const PortalFrame> frame;unsigned views{},projections{};};
+std::array<Slot,64> slots;
+std::uint64_t mappingSession{},mappingEpoch{};
+portal::RigidTransform runtimeMapping{},gameBasis{};
+portal::Quaternion inverse(portal::Quaternion q){return {-q.x,-q.y,-q.z,q.w};}
+}
+std::shared_ptr<const PortalFrame> PortalFrame::latch(std::uint64_t id,const portal::RigidTransform& raw){
+    if(!WindowMode::get()->portal_output_enabled())return {};
+    std::scoped_lock lock(cacheMutex);
+    auto& slot=slots[id%slots.size()];
+    if(slot.frame&&slot.frame->gameFrameID==id)return slot.frame;
+    auto frame=std::make_shared<PortalFrame>();frame->gameFrameID=id;
+    const auto state=PortalSession::get().latest();
+    if(state)frame->state=*state;
+    const auto vr=VR::get();
+    if(!vr->get_runtime()->is_openvr()||vr->is_using_afr()||vr->is_using_2d_screen()||vr->is_extreme_compatibility_mode_enabled()||
+       vr->is_splitscreen_compatibility_enabled()||vr->is_sceneview_compatibility_enabled()||vr->is_native_stereo_fix_enabled()||vr->is_stereo_emulation_enabled()||
+       vr->is_roomscale_enabled()||vr->is_headlocked_aim_enabled()||vr->is_controller_aim_enabled()||vr->is_decoupled_pitch_enabled())frame->error="unsupported_portal_configuration";
+    else if(state&&portal::validTransform(raw)){
+        frame->state=*state;
+        if(mappingSession!=state->sessionID||mappingEpoch!=state->trackingEpoch){
+            const auto q=portal::multiply(raw.orientation,inverse(state->worldFromHead.orientation));
+            runtimeMapping={portal::subtract(raw.position,portal::rotate(q,state->worldFromHead.position)),q};
+            // Fixed camera origin/basis for this tracking epoch. Moving/resizing the rectangle never changes it.
+            gameBasis={state->worldFromHead.position,state->worldFromPortal.orientation};
+            mappingSession=state->sessionID;mappingEpoch=state->trackingEpoch;
+        }
+        frame->runtimeFromExternal=runtimeMapping;frame->gameBasis=gameBasis;
+        frame->runtimeHead=portal::compose(runtimeMapping,{state->worldFromHead.position,state->worldFromPortal.orientation});
+        const portal::PortalGeometry geometry{state->worldFromPortal,state->widthMeters,state->heightMeters,state->geometryRevision};
+        const auto eyes=portal::eyePositions(state->worldFromHead,state->eyeSeparationMeters);
+        if(eyes){
+            frame->externalEyes=*eyes;
+            const auto left=portal::portalFrustum(geometry,(*eyes)[0]);const auto right=portal::portalFrustum(geometry,(*eyes)[1]);
+            if(left&&right){
+                frame->frusta={*left,*right};frame->valid=true;frame->error="none";
+                for(unsigned eye=0;eye<2;++eye)frame->eyeOffsets[eye]=portal::rotate(inverse(state->worldFromPortal.orientation),portal::subtract((*eyes)[eye],state->worldFromHead.position));
+            }else frame->error="eye_behind_or_near_portal";
+        }else frame->error="invalid_calibration";
+    }
+    slot={frame,0,0};currentID.store(id,std::memory_order_release);
+    SPDLOG_DEBUG("[Portal] latch frame={} seq={} geometry={} valid={} error={}",id,frame->state.sequence,frame->state.geometryRevision,frame->valid,frame->error);
+    return frame;
+}
+std::shared_ptr<const PortalFrame> PortalFrame::current(){return find(currentID.load(std::memory_order_acquire));}
+std::shared_ptr<const PortalFrame> PortalFrame::find(std::uint64_t id){
+    std::scoped_lock lock(cacheMutex);const auto& s=slots[id%slots.size()];return s.frame&&s.frame->gameFrameID==id?s.frame:nullptr;
+}
+void PortalFrame::observe(std::uint64_t id,unsigned eye,bool projection){
+    if(eye>1)return;std::scoped_lock lock(cacheMutex);auto& s=slots[id%slots.size()];
+    if(s.frame&&s.frame->gameFrameID==id){(projection?s.projections:s.views)|=1u<<eye;
+        SPDLOG_DEBUG("[Portal] {} frame={} eye={} seq={} geometry={}",projection?"projection":"view",id,eye,s.frame->state.sequence,s.frame->state.geometryRevision);}
+}
+bool PortalFrame::paired(std::uint64_t id){std::scoped_lock lock(cacheMutex);const auto& s=slots[id%slots.size()];return s.frame&&s.frame->gameFrameID==id&&s.views==3&&s.projections==3;}
+void PortalFrame::reset(){std::scoped_lock lock(cacheMutex);slots={};mappingSession=0;mappingEpoch=0;}
+}
diff --git a/src/mods/portal/PortalFrame.hpp b/src/mods/portal/PortalFrame.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..74ab8934a34f71eccc4add0c920cb337f51dcb36
--- /dev/null
+++ b/src/mods/portal/PortalFrame.hpp
@@ -0,0 +1,26 @@
+#pragma once
+#include <portal/Protocol.hpp>
+#include <array>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+
+namespace uevrportal {
+struct PortalFrame {
+    portal::StateSnapshot state{};
+    std::uint64_t gameFrameID{};
+    portal::RigidTransform runtimeFromExternal{},gameBasis{},runtimeHead{};
+    std::array<portal::Vec3,2> externalEyes{},eyeOffsets{};
+    std::array<portal::EyeFrustum,2> frusta{};
+    bool valid{};
+    std::string error="awaiting_state";
+    // Called only by OpenVR update_poses with the engine frame identifier and unmodified runtime pose.
+    static std::shared_ptr<const PortalFrame> latch(std::uint64_t gameFrameID,const portal::RigidTransform& runtimeHead);
+    static std::shared_ptr<const PortalFrame> find(std::uint64_t gameFrameID);
+    static std::shared_ptr<const PortalFrame> current();
+    static void observe(std::uint64_t gameFrameID,unsigned eye,bool projection);
+    static bool paired(std::uint64_t gameFrameID);
+    static void reset();
+};
+}
diff --git a/src/mods/portal/PortalIntegration.hpp b/src/mods/portal/PortalIntegration.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..1396bb26bab2d811a781e0d0a84b0d5689689ad4
--- /dev/null
+++ b/src/mods/portal/PortalIntegration.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include "PortalFrame.hpp"
+#include "../WindowMode.hpp"
+#include "../VR.hpp"
+#include <cmath>
+#include <glm/gtc/quaternion.hpp>
+#include <glm/gtx/quaternion.hpp>
+#include <glm/gtx/euler_angles.hpp>
+namespace uevrportal {
+inline std::shared_ptr<const PortalFrame> gameFrame(){return PortalFrame::current();}
+inline Matrix4x4f matrix(const portal::RigidTransform& t){
+    auto m=glm::mat4_cast(glm::quat{float(t.orientation.w),float(t.orientation.x),float(t.orientation.y),float(t.orientation.z)});
+    m[3]=Vector4f{float(t.position.x),float(t.position.y),float(t.position.z),1.f};return m;
+}
+inline portal::RigidTransform transform(const Matrix4x4f& m){
+    const auto q=glm::normalize(glm::quat{m});return {{m[3].x,m[3].y,m[3].z},{q.x,q.y,q.z,q.w}};
+}
+inline Matrix4x4f eyeMatrix(unsigned eye){
+    auto m=glm::identity<Matrix4x4f>();const auto f=gameFrame();
+    if(f&&f->valid&&eye<2){const auto p=f->eyeOffsets[eye];m[3]=Vector4f{float(p.x),float(p.y),float(p.z),1};}return m;
+}
+inline Matrix4x4f projection(unsigned eye,double nearUnits){
+    auto m=glm::identity<Matrix4x4f>();const auto f=gameFrame();
+    if(f&&f->valid&&eye<2&&std::isfinite(nearUnits)&&nearUnits>0){
+        const auto a=portal::toUnrealReversedZ(f->frusta[eye],nearUnits);
+        for(unsigned c=0;c<4;++c)for(unsigned row=0;row<4;++row)m[c][row]=float(a[c*4+row]);
+    }return m;
+}
+// Unreal camera basis: +X forward,+Y right,+Z up. External: +X right,+Y up,+Z toward viewer.
+// The incoming game camera remains authoritative for gamepad locomotion; physical offset is added once.
+template<class Rotation,class Location>
+inline void applyView(const PortalFrame& f,unsigned eye,Rotation& rotation,Location& location,double scale){
+    const double pitch=glm::radians(double(rotation.pitch)),yaw=glm::radians(double(rotation.yaw)),roll=glm::radians(double(rotation.roll));
+    const auto game=glm::angleAxis(yaw,glm::dvec3{0,0,1})*glm::angleAxis(-pitch,glm::dvec3{0,1,0})*glm::angleAxis(-roll,glm::dvec3{1,0,0});
+    const auto p=portal::inverseTransformPoint(f.gameBasis,f.externalEyes[eye]);
+    const auto delta=game*(glm::dvec3{-p.z,p.x,p.y}*scale);
+    location.x+=delta.x;location.y+=delta.y;location.z+=delta.z;
+    const auto b=f.gameBasis.orientation;
+    const auto q=portal::multiply({-b.x,-b.y,-b.z,b.w},f.state.worldFromPortal.orientation);
+    // Quaternion vector transforms as an axial vector under the handedness change.
+    const auto composed=game*glm::dquat{q.w,q.z,-q.x,-q.y};
+    double y,pit,r;glm::extractEulerAngleZYX(glm::mat4_cast(composed),y,pit,r);
+    rotation.pitch=glm::degrees(-pit);rotation.yaw=glm::degrees(y);rotation.roll=glm::degrees(-r);
+}
+}
