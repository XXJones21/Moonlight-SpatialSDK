new file mode 100644
index 0000000000000000000000000000000000000000..67ff75f5f6c28b0b7022d76efe0be2b3411bd2d6
--- /dev/null
+++ b/src/mods/portal/PortalSession.cpp
@@ -0,0 +1,65 @@
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include "PortalSession.hpp"
+#include <array>
+#pragma comment(lib,"ws2_32")
+
+namespace uevrportal {
+PortalSession& PortalSession::get(){static PortalSession session;return session;}
+PortalSession::PortalSession():worker_([this](std::stop_token stop){receive(stop);}){}
+PortalSession::~PortalSession(){worker_.request_stop();if(worker_.joinable())worker_.join();}
+std::optional<portal::StateSnapshot> PortalSession::latest() const {
+    std::scoped_lock lock(mutex_);
+    if(acceptance_.stale(portal::StateAcceptance::Clock::now()))return {};
+    return acceptance_.latest();
+}
+bool PortalSession::matchesLease(const portal::StateSnapshot& state) const {
+    std::scoped_lock lock(mutex_);
+    return !acceptance_.stale(portal::StateAcceptance::Clock::now())&&state.sessionID==acceptance_.sessionID()&&state.trackingEpoch==acceptance_.trackingEpoch();
+}
+void PortalSession::status(portal::StatusSnapshot s){std::scoped_lock lock(mutex_);status_=std::move(s);statusTime_=portal::StateAcceptance::Clock::now();}
+std::string PortalSession::error()const{std::scoped_lock lock(mutex_);return error_;}
+void PortalSession::receive(std::stop_token stop){
+    WSADATA data{};
+    auto fail=[&](const char* e){std::scoped_lock lock(mutex_);error_=e;};
+    if(WSAStartup(MAKEWORD(2,2),&data)){fail("winsock_start_failed");return;}
+    SOCKET socket=::socket(AF_INET,SOCK_DGRAM,IPPROTO_UDP);
+    if(socket==INVALID_SOCKET){fail("socket_failed");WSACleanup();return;}
+    BOOL exclusive=TRUE;setsockopt(socket,SOL_SOCKET,SO_EXCLUSIVEADDRUSE,reinterpret_cast<char*>(&exclusive),sizeof(exclusive));
+    sockaddr_in local{};local.sin_family=AF_INET;local.sin_addr.s_addr=htonl(INADDR_LOOPBACK);local.sin_port=htons(4244);
+    if(bind(socket,reinterpret_cast<sockaddr*>(&local),sizeof(local))==SOCKET_ERROR){fail("loopback_4244_bind_failed");closesocket(socket);WSACleanup();return;}
+    sockaddr_in host=local;host.sin_port=htons(4243);
+    auto lastStatus=portal::StateAcceptance::Clock::now();
+    while(!stop.stop_requested()){
+        fd_set read;FD_ZERO(&read);FD_SET(socket,&read);timeval timeout{0,20000};
+        if(select(0,&read,nullptr,nullptr,&timeout)>0){
+            std::array<std::byte,2048> buffer{};sockaddr_in from{};int length=sizeof(from);
+            const int n=recvfrom(socket,reinterpret_cast<char*>(buffer.data()),int(buffer.size()),0,reinterpret_cast<sockaddr*>(&from),&length);
+            if(n>0&&from.sin_family==AF_INET&&from.sin_addr.s_addr==host.sin_addr.s_addr&&from.sin_port==host.sin_port){
+                const auto bytes=std::span<const std::byte>{buffer.data(),static_cast<size_t>(n)};
+                const auto state=portal::decodeState(bytes);const auto reset=portal::decodeReset(bytes);
+                std::scoped_lock lock(mutex_);
+                if(state&&acceptance_.accept(*state,portal::StateAcceptance::Clock::now()))error_=state->trackingValid?"none":"tracking_invalid";
+                else if(reset&&acceptance_.acceptReset(*reset))error_="awaiting_epoch_state";
+                else error_="rejected_packet";
+            }
+        }
+        const auto now=portal::StateAcceptance::Clock::now();
+        if(now-lastStatus>=std::chrono::milliseconds(50)){
+            portal::StatusSnapshot out;
+            {std::scoped_lock lock(mutex_);out=status_;
+                if(out.sessionID!=acceptance_.sessionID()||out.trackingEpoch!=acceptance_.trackingEpoch()||acceptance_.stale(now)){
+                    const auto& last=acceptance_.latest();
+                    out={acceptance_.sessionID(),acceptance_.trackingEpoch(),last?last->sequence:0,last?last->geometryRevision:0,0,false,"direct_sbs",acceptance_.stale(now)?"staleTracking":"outputUnavailable"};
+                }
+            }
+            if(!out.sessionID||!out.trackingEpoch){lastStatus=now;continue;}
+            {std::scoped_lock lock(mutex_);if(now-statusTime_>portal::TrackingLease){out.trackingValid=false;out.errorCode="outputUnavailable";}}
+            const auto json=portal::encodeStatus(out);
+            sendto(socket,json.data(),static_cast<int>(json.size()),0,reinterpret_cast<sockaddr*>(&host),sizeof(host));
+            lastStatus=now;
+        }
+    }
+    closesocket(socket);WSACleanup();
+}
+}
