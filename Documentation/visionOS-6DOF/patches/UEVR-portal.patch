+            out[y*width+eye*w+x]=color;
+        }
+        // Decimal glyphs: eye 0/1, corners 1..4; frame and geometry in two rows.
+        constexpr unsigned glyphs[10]={0x7b6f,0x2492,0x73e7,0x73cf,0x5bc9,0x79cf,0x79ef,0x7249,0x7bef,0x7bcf};
+        auto text=[&](unsigned tx,unsigned ty,const char* value){for(;*value;++value,tx+=16){if(*value<'0'||*value>'9')continue;const auto bits=glyphs[*value-'0'];
+            for(unsigned gy=0;gy<5;++gy)for(unsigned gx=0;gx<3;++gx)if(bits&(1u<<(14-gy*3-gx)))for(unsigned sy=0;sy<4;++sy)for(unsigned sx=0;sx<4;++sx){const auto xx=tx+gx*4+sx,yy=ty+gy*4+sy;if(xx<w&&yy<height)out[yy*width+eye*w+xx]=0xffffffff;}}};
+        text(12,12,"1");text(w>32?w-32:0,12,"2");text(12,height>32?height-32:0,"3");text(w>32?w-32:0,height>32?height-32:0,"4");
