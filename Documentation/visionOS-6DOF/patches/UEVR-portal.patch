+}
+std::vector<std::uint32_t> strip(unsigned w,const PortalFrame* f){
+    portal::FrameMetadata m{};
+    if(f)m={true,f->state.sessionID,f->state.trackingEpoch,f->state.geometryRevision,f->gameFrameID};
+    const auto tag=portal::encodeFrameMetadata(m);
+    std::vector<std::uint32_t> pixels(w*2*16);
+    for(unsigned y=0;y<16;++y)for(unsigned x=0;x<w*2;++x)pixels[y*w*2+x]=portal::metadataPixel(tag,w,x%w,y);
+    return pixels;
+}
+// Deliberate synthetic fixture upload (no game image readback). Three fixed-depth panels expose parallax.
+// The diagnostic replaces both source eyes before the same GPU output copies and metadata append.
+std::vector<std::uint32_t> diagnostic(unsigned width,unsigned height,const PortalFrame& f){
+    std::vector<std::uint32_t> out(width*height,0xff101010);const unsigned w=width/2;
+    for(unsigned eye=0;eye<2;++eye){const auto fr=f.frusta[eye];const auto origin=portal::inverseTransformPoint(f.gameBasis,f.externalEyes[eye]);
+        const auto b=f.gameBasis.orientation;const auto q=portal::multiply({-b.x,-b.y,-b.z,b.w},f.state.worldFromPortal.orientation);
+        for(unsigned y=0;y<height;++y)for(unsigned x=0;x<w;++x){
+            const auto ray=portal::rotate(q,{fr.left+(fr.right-fr.left)*(x+.5)/w,fr.top-(fr.top-fr.bottom)*(y+.5)/height,-1});
+            std::uint32_t color=0xff181818;
+            for(int plane=3;plane>=1;--plane){const double depth=plane*1.25;const double t=(-depth-origin.z)/ray.z;
+                const double px=origin.x+ray.x*t,py=origin.y+ray.y*t;
+                if(t>0&&std::abs(px-(plane-2)*.6)<.25&&std::abs(py)<.5){const bool check=(int(std::floor(px*20))+int(std::floor(py*20)))&1;color=check?0xffdddddd:0xff333333;}}
