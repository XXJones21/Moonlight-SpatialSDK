# Keystore configuration for signing release APKs
# Copy this file to keystore.properties and fill in your actual values
# DO NOT commit keystore.properties to version control

# Path to your keystore file (relative to project root)
storeFile=app/release.keystore

# Keystore password
storePassword=your_keystore_password_here

# Key alias name
keyAlias=release_key

# Key password (can be same as storePassword)
keyPassword=your_key_password_here
