+        std::snprintf(value,sizeof(value),"%llu",static_cast<unsigned long long>(f.state.geometryRevision));text(12,76,value);
+    }return out;
+}
+D3D12_RESOURCE_BARRIER transition(ID3D12Resource* r,D3D12_RESOURCE_STATES a,D3D12_RESOURCE_STATES b){
